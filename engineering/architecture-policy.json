{
  "sourceRoots": ["app", "worker", "db", "android-client", "build"],
  "gameRoot": "app/game",
  "backendRoot": "app/backend",
  "serverRoots": ["app/backend", "app/api", "db", "worker"],
  "frontendRoots": ["app/components", "android-client"],
  "modulePaths": { "@/*": ["./*"] },
  "pureGameModules": [
    "account-operation-gate.ts",
    "board-rules.ts",
    "bot-player.ts",
    "card-effects.ts",
    "card-filters.ts",
    "card-interaction.ts",
    "card-mechanics.ts",
    "card-purchase.ts",
    "card-reveal-profile.ts",
    "card-transfer-layout.ts",
    "cards.ts",
    "collection-progress.ts",
    "collections.ts",
    "element-progression.ts",
    "engine.ts",
    "game-mode.ts",
    "game-presentation.ts",
    "network-message.ts",
    "player-progress.ts",
    "progress-request-error.ts",
    "progression-copy.ts",
    "roguelike.ts",
    "round-progression.ts",
    "round-transition.ts",
    "saved-decks.ts",
    "turn-effects.ts"
  ],
  "adapterGameModules": [
    "account-cache.ts",
    "animation-sequence.ts",
    "card-reveal-audio.ts",
    "local-player-progress.ts",
    "local-progress-commit.ts",
    "localization.tsx",
    "photon-config.ts",
    "photon.ts",
    "player-progress-client.ts",
    "progress-operation-queue.ts",
    "progress-sync.ts",
    "request-timeout.ts",
    "round-progress-client.ts"
  ],
  "platformPackages": ["react", "react-dom", "@capacitor", "photon-realtime", "next/navigation"],
  "serverPackages": ["drizzle-orm", "cloudflare:workers", "node:"],
  "forbiddenCoreGlobals": [
    "window", "document", "navigator", "localStorage", "sessionStorage", "indexedDB", "caches",
    "fetch", "WebSocket", "XMLHttpRequest", "EventSource", "Request", "Response", "Headers",
    "Audio", "AudioContext", "webkitAudioContext", "Image", "Worker", "SharedWorker",
    "setTimeout", "clearTimeout", "setInterval", "clearInterval", "requestAnimationFrame", "cancelAnimationFrame",
    "process", "require", "globalThis", "self", "global"
  ],
  "forbiddenCoreMethods": ["getItem", "setItem", "removeItem"]
}
