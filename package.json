{
  "name": "tic-tac-toe-plus-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "android:web": "vite build --config vite.android.config.ts",
    "android:sync": "npm run android:web && cap sync android",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.db.jsonc"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "photon-realtime": "^4.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
